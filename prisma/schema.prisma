generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  patient
  clinician
  admin
  front_desk
}

enum RecordType {
  note
  diagnosis
  prescription
  lab_result
  vitals
}

enum AppointmentStatus {
  scheduled
  confirmed
  cancelled
  completed
  no_show
}

enum AccessGrantReason {
  active_care
  referral
  emergency_override
}

enum AuditAction {
  view
  create
  update
  export
  emergency_override
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name")
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at")

  patient           Patient?
  clinician         Clinician?
  refreshTokens     RefreshToken[]
  createdAppointments Appointment[]     @relation("AppointmentCreatedBy")
  grantsGiven       AccessGrant[]      @relation("AccessGrantGrantedBy")
  auditEntries      AuditLogEntry[]    @relation("AuditActor")

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  family     String    @db.Uuid
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

model Patient {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String?  @unique @map("user_id") @db.Uuid
  dateOfBirth DateTime @map("date_of_birth") @db.Date
  sex         String
  phone       String?
  address     String?
  createdAt   DateTime @default(now()) @map("created_at")

  user           User?           @relation(fields: [userId], references: [id])
  medicalRecords MedicalRecord[]
  appointments   Appointment[]
  accessGrants   AccessGrant[]
  auditEntries   AuditLogEntry[]

  @@map("patients")
}

model Clinician {
  id            String @id @default(uuid()) @db.Uuid
  userId        String @unique @map("user_id") @db.Uuid
  specialty     String
  licenseNumber String @map("license_number")

  user           User            @relation(fields: [userId], references: [id])
  authoredRecords MedicalRecord[]
  appointments    Appointment[]
  accessGrants    AccessGrant[]

  @@map("clinicians")
}

model MedicalRecord {
  id             String     @id @default(uuid()) @db.Uuid
  patientId      String     @map("patient_id") @db.Uuid
  authoredBy     String     @map("authored_by") @db.Uuid
  recordType     RecordType @map("record_type")
  content        Json
  amendsRecordId String?    @map("amends_record_id") @db.Uuid
  createdAt      DateTime   @default(now()) @map("created_at")

  patient      Patient         @relation(fields: [patientId], references: [id])
  author       Clinician       @relation(fields: [authoredBy], references: [id])
  amends       MedicalRecord?  @relation("Amendments", fields: [amendsRecordId], references: [id])
  amendedBy    MedicalRecord[] @relation("Amendments")

  @@index([patientId, createdAt])
  @@map("medical_records")
}

model Appointment {
  id          String            @id @default(uuid()) @db.Uuid
  patientId   String            @map("patient_id") @db.Uuid
  clinicianId String            @map("clinician_id") @db.Uuid
  startTime   DateTime          @map("start_time")
  endTime     DateTime          @map("end_time")
  status      AppointmentStatus @default(scheduled)
  reason      String?
  createdBy   String            @map("created_by") @db.Uuid
  idempotencyKey String?        @unique @map("idempotency_key")
  createdAt   DateTime          @default(now()) @map("created_at")

  patient   Patient   @relation(fields: [patientId], references: [id])
  clinician Clinician @relation(fields: [clinicianId], references: [id])
  creator   User      @relation("AppointmentCreatedBy", fields: [createdBy], references: [id])

  @@index([clinicianId, startTime])
  @@index([patientId, startTime])
  @@map("appointments")
}

model AccessGrant {
  id          String            @id @default(uuid()) @db.Uuid
  patientId   String            @map("patient_id") @db.Uuid
  clinicianId String            @map("clinician_id") @db.Uuid
  grantedBy   String            @map("granted_by") @db.Uuid
  reason      AccessGrantReason
  expiresAt   DateTime?         @map("expires_at")
  revokedAt   DateTime?         @map("revoked_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  patient   Patient   @relation(fields: [patientId], references: [id])
  clinician Clinician @relation(fields: [clinicianId], references: [id])
  grantor   User      @relation("AccessGrantGrantedBy", fields: [grantedBy], references: [id])

  @@index([patientId, clinicianId])
  @@map("access_grants")
}

model AuditLogEntry {
  id           String      @id @default(uuid()) @db.Uuid
  actorUserId  String      @map("actor_user_id") @db.Uuid
  action       AuditAction
  resourceType String      @map("resource_type")
  resourceId   String      @map("resource_id") @db.Uuid
  patientId    String?     @map("patient_id") @db.Uuid
  metadata     Json?
  occurredAt   DateTime    @default(now()) @map("occurred_at")

  actor   User     @relation("AuditActor", fields: [actorUserId], references: [id])
  patient Patient? @relation(fields: [patientId], references: [id])

  @@index([patientId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@map("audit_log_entries")
}
