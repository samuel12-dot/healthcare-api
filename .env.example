# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Postgres — used by Prisma migrations and the app's runtime role.
# The runtime role (app_user) has restricted grants applied via scripts/db-roles.sql
# after migrations run — see README "Database roles" section.
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/healthcare?schema=public
# Superuser connection used only for running migrations and applying role grants.
DATABASE_MIGRATE_URL=postgresql://postgres:postgres@localhost:5432/healthcare?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# Rate limiting
RATE_LIMIT_AUTH_POINTS=5
RATE_LIMIT_AUTH_DURATION_SECONDS=60
RATE_LIMIT_DEFAULT_POINTS=100
RATE_LIMIT_DEFAULT_DURATION_SECONDS=60
